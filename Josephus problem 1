#include <iostream>
#include <queue>
using namespace std;

int main() {
    int n;
    cin >> n;

    queue<int> q;

    for (int i = 1; i <= n; i++) {
        q.push(i);
    }

    while (!q.empty()) {
        q.push(q.front());
        q.pop();

        cout << q.front();
        q.pop();

        if (!q.empty()) cout << " ";
    }

    cout << endl;

    return 0;
}
